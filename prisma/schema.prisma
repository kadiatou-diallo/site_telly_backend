generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Formation {
  id                 Int      @id @default(autoincrement())
  titre              String
  slug               String   @unique
  description        String
  programme          String?
  mensualite         Int?
  nombreMois         Int?
  imageUrl           String?
  brochureUrl        String?
  categorie          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  disponibilite      String   @default("Actuellement disponible")
  estActif           Boolean  @default(true)
  montantInscription Int?
  niveau             String   @default("Débutant")
  objectifs          String?
  prerequis          String?
}

model Message {
  id        Int      @id @default(autoincrement())
  prenom    String
  nom       String
  email     String
  telephone String?
  sujet     String
  message   String
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Inscription {
  id                 Int                @id @default(autoincrement())
  nom                String
  prenom             String
  email              String             @unique
  telephone          String
  formation          String
  montantInscription Int                @default(30000)
  mensualite         Int?
  nombreMois         Int?
  cohorte            Int?
  estActif           Boolean            @default(true)
  // 🆕 Date réelle de démarrage de l'étudiant (peut différer de la date
  // officielle de la cohorte si l'étudiant rejoint en retard).
  // Fixée automatiquement à la validation, modifiable par l'admin.
    mode               ModeInscription    @default(PRESENTIEL)
  universite         String?
  promotion          String?
  filiere            String?
  dateDemarrage      DateTime?
  dateFinFormation   DateTime?
  status             Status             @default(PENDING)
  code               String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  devoirSoumissions  DevoirSubmission[]
  lessonSubmissions  LessonSubmission[]
  paiements          Paiement[]
  submissions        Submission[]
    relances      Relance[]
}

model Paiement {
  id             Int            @id @default(autoincrement())
  inscriptionId  Int
  mois           Int
  // 🆕 Mois calendaire réel auquel correspond cette mensualité,
  // au format "YYYY-MM" (ex: "2026-02"), calculé à partir de
  // Inscription.dateDemarrage. Permet les stats par mois réel,
  // toutes cohortes confondues, indépendamment du "mois" relatif.
  moisCalendaire String?
  montant        Int
  status         StatusPaiement @default(EN_ATTENTE)
  dateValidation DateTime?
  recuUrl        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  inscription    Inscription    @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)

  @@index([moisCalendaire])
}

model CourseModule {
  id          String         @id @default(cuid())
  formation   String
  titre       String
  ordre       Int
  description String
  duree       String
  imageUrl      String?   // 🆕 photo optionnelle du module
 
  objectifs   String[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lessons     CourseLesson[]

  @@index([formation])
  @@index([formation, ordre])
}

model CourseLesson {
  id                         String             @id @default(cuid())
  moduleId                   String
  titre                      String
  ordre                      Int
  description                String
  duree                      String
  videoUrl                   String?
  videoType                  String?
  videoPublicId              String?
  pdfUrl                     String?
  pdfPublicId                String?
  pdfExoUrl                  String?
  pdfExoPublicId             String?
  consigneExo                String?
  requiresPreviousValidation Boolean            @default(true)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  module                     CourseModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions                LessonSubmission[]
  hasEditor                  Boolean            @default(false)
  starterCode                String?

  @@index([moduleId])
  @@index([moduleId, ordre])
}

model LessonSubmission {
  id            Int              @id @default(autoincrement())
  lessonId      String
  inscriptionId Int
  link          String?
  fileUrl       String?
  filePublicId  String?
  fileName      String?
  note          Int?
  feedback      String?
  status        SubmissionStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  inscription   Inscription      @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
  lesson        CourseLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, inscriptionId])
  @@index([inscriptionId])
  @@index([lessonId])
  @@index([status])
}

model Assignment {
  id          Int          @id @default(autoincrement())
  partId      String
  lessonId    String
  moduleId    String
  formation   String
  instruction String
  createdAt   DateTime     @default(now())
  submissions Submission[]

  @@unique([partId, formation])
  @@index([lessonId, moduleId])
}

model Submission {
  id            Int              @id @default(autoincrement())
  assignmentId  Int
  inscriptionId Int
  link          String
  status        SubmissionStatus @default(PENDING)
  feedback      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  assignment    Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  inscription   Inscription      @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)

  @@unique([inscriptionId, assignmentId])
  @@index([inscriptionId])
  @@index([assignmentId])
  @@index([status])
}

model Evenement {
  id          Int       @id @default(autoincrement())
  titre       String
  slug        String    @unique
  description String
  date        DateTime
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  gallery     Galerie[]
}

model Galerie {
  id          Int       @id @default(autoincrement())
  url         String
  titre       String
  description String?
  categorie   String
  estActif    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  evenementId Int?
  evenement   Evenement? @relation(fields: [evenementId], references: [id])

  @@index([categorie])
  @@index([estActif, createdAt])
}

model Article {
  id              Int            @id @default(autoincrement())
  titre           String
  slug            String         @unique
  extrait         String?
  contenu         String
  imageUrl        String?
  videoUrl        String?       // vidéo unique (YouTube/Cloudinary), optionnelle
  categorie       String?
  auteur          String         @default("TellyTech")

  // SEO / IA
  metaTitle       String?
  metaDescription String?
  motsCles        String[]

  estPublie       Boolean        @default(false)
  publieAt        DateTime?
  vues            Int            @default(0)
  nbLikes         Int            @default(0)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  medias          ArticleMedia[]
  commentaires    Commentaire[]
  likes           Like[]

  @@index([estPublie, publieAt])
  @@index([categorie])
}

model ArticleMedia {
  id        Int      @id @default(autoincrement())
  articleId Int
  url       String
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model Commentaire {
  id          Int      @id @default(autoincrement())
  articleId   Int
  nom         String
  email       String?
  contenu     String
  estApprouve Boolean  @default(true)
  createdAt   DateTime @default(now())
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([estApprouve])
}

model Like {
  id          Int      @id @default(autoincrement())
  articleId   Int
  identifiant String
  type        String   @default("utile")
  createdAt   DateTime @default(now())
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, identifiant, type])
  @@index([articleId])
}

model FaqItem {
  id        Int      @id @default(autoincrement())
  question  String
  reponse   String
  categorie String?
  ordre     Int      @default(0)
  estActif  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categorie])
  @@index([estActif])
}

model Service {
  id          Int      @id @default(autoincrement())
  titre       String
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  nom       String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  formation String?
  cohorte   Int?
  createdAt DateTime @default(now())
}

model Devoir {
  id              Int                @id @default(autoincrement())
  titre           String
  consigne        String
  fichierUrl      String?
  fichierPublicId String?
  formation       String
  cohorte         Int?
  ouvertureAt     DateTime
  deadline        DateTime
  dureeMinutes    Int
  actif           Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  soumissions     DevoirSubmission[]

  @@index([formation])
  @@index([formation, cohorte])
  @@index([actif])
}

model DevoirSubmission {
  id              Int              @id @default(autoincrement())
  devoirId        Int
  inscriptionId   Int
  fichierUrl      String?
  fichierPublicId String?
  fileName        String?
  note            Int?
  feedback        String?
  status          SubmissionStatus @default(PENDING)
  soumisAt        DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  appreciation    String?
  devoir          Devoir           @relation(fields: [devoirId], references: [id], onDelete: Cascade)
  inscription     Inscription      @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)

  @@unique([devoirId, inscriptionId])
  @@index([devoirId])
  @@index([inscriptionId])
  @@index([status])
}
model Relance {
  id            Int         @id @default(autoincrement())
  inscriptionId Int
  inscription   Inscription @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
  canal         String      // "EMAIL" ou "WHATSAPP"
  moisManquants String      // ex : "Août 2026, Septembre 2026"
  statut        String      // "ENVOYE" ou "ECHEC"
  erreur        String?
  createdAt     DateTime    @default(now())

  @@index([inscriptionId, canal, createdAt])
}
model EmploiDuTemps {
  id         Int       @id @default(autoincrement())
  formation  String
  cohorte    String
  jour       Jour
  heureDebut String
  heureFin   String
  matiere    String
  type       TypeCours
  salle      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([formation])
  @@index([formation, cohorte])
  @@index([formation, jour])
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Status {
  PENDING
  VALIDATED
}

enum StatusPaiement {
  EN_ATTENTE
  VALIDE
  REJETE
}

enum Role {
  ADMIN
  USER
  COACH
}

enum Jour {
  Lundi
  Mardi
  Mercredi
  Jeudi
  Vendredi
  Samedi
}

enum TypeCours {
  cours
  tp
  projet
}

enum ContentStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}
enum ModeInscription {
  EN_LIGNE
  PRESENTIEL
  PONCTUEL
  GRATUIT
}